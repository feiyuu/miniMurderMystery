<import src="../authtep/authtep.wxml"></import>
<view>
    <view class="container bg">
        <view class="juben-info">
            <view class="image-box" data-dramaId="{{detailData.dramaId}}">
                <image src="{{tools.transformImageUrl(detailData.dramaCover)}}" style="border-radius:12rpx"></image>
            </view>
            <view class="infos">
                <view class="name"> {{detailData.dramaName}}</view>
                <view class="gates">{{detailData.NanNvShu}} </view>
                <view class="gates">{{detailData.duration}}小时</view>
                <view class="gates">难度： {{detailData.difficulty}}</view>
                <view class="gates">{{detailData.genre}}/{{detailData.background}}/{{detailData.theme}}</view>
                <view class="gates">{{detailData.price}}元/人</view>
                <starts class="gates" score="{{detailData.dramaGrade}}"></starts>
            </view>
            <view class="collect" bindtap="collectDrama" wx:if="{{!isTeam}}">
                <image src="{{tools.collectUrl(detailData.isCollect)}}"></image>
                <view class="collect-tit">{{detailData.isCollect?'已收藏':'收藏'}}</view>
            </view>
        </view>
        <view class="juben-content">
            <view class="jb-kaiju flex-hor flex-center" wx:if="{{isTeam}}">
                <view class="header-item">
                    <text class="tit">开局时间</text>
                    <text class="tit-bottom">{{detailData.startDate+" "+detailData.startSession}}</text>
                </view>
                <view class="header-item">
                    <text class="tit">主持人</text>
                    <text class="tit-bottom">{{detailData.dmNickName}}</text>
                </view>
                <view class="header-item">
                    <button class="btn-share" openType="share">
                        <view class="share">
                            <image src="/img/tb/{{tubiao}}/wx-share.png"></image>
                            <view class="share-tit">邀请参加</view>
                        </view>
                    </button>
                </view>
            </view>
            <view class="intro" wx:if="{{detailData.profile}}">
                <view class="tit">剧本简介</view>
                <view class="words  {{gushiHide?'':'row-ellipsis'}}">
                    <text bindtap="gsToggle">{{detailData.profile}}</text>
                    <view bindtap="gsToggle" class="btn">
                        <image mode="aspectFillg" src="/assets/images/ic-carter-down.png"></image>
                    </view>
                </view>
            </view>
            <view class="juese" wx:if="{{detailData.roles&&detailData.roles.length>0}}">
                <view class="tit">角色介绍</view>
                <view class="js-list">
                    <swiper displayMultipleItems="2" duration="500" interval="5000" nextMargin="10rpx" previousMargin="10rpx" style="width: 100%;height: 450rpx;">
                        <swiper-item wx:for="{{detailData.roles}}">
                            <view class="swiper-item" style="font-size: 24rpx;">
                                <image bindtap="roleIntro" data-index="{{index}}" mode="aspectFill" src="{{tools.imageMogr(item.roleAvatar,'0/w/200')}}" style="border-radius:12rpx;width: 300rpx;height: 380rpx;"></image>
                                <view class="name" style="margin-top: 12rpx;">{{item.roleName}} · {{item.roleSex}}</view>
                            </view>
                        </swiper-item>
                    </swiper>
                </view>
            </view>

            <view class="jb-members" wx:if="{{isTeam}}">
                <view class="title"><text>组局成员</text><text style="font-size: 28rpx;">({{detailData.teamUsers.length}}/{{detailData.numbers}})</text></view>
                <view class="list" wx:for="{{detailData.teamUsers}}">
                    <view class="mem-section flex-jus">
                        <view class="left flex-ver">
                            <view class="head-img">
                                <image class="head" mode="aspectFill" src="{{tools.transformImageUrl(item.avatarUrl)}}" style="border-radius:50%"></image>
                                <image class="sex" mode="aspectFill" src="{{item.gender==1?'/assets/images/ic-sex-circle-male.png':'/assets/images/ic-sex-circle-female.png'}}"></image>
                            </view>
                            <view class="infos">
                                <text class="name">{{item.nickName}}</text>
                                <text class="dt">{{item.teamUserJoinTime}}</text>
                            </view>
                        </view>
                        <view class="grade"></view>
                    </view>
                </view>
            </view>
            <view class="join-in flex-center" wx:if="{{isTeam&&detailData.status!==20}}">
                <button class="jiaruzuju" wx:if="{{joined}}">已加入</button>
                <button class="jiaruzuju" wx:elif="{{fullPeoples}}">本局人已满</button>
                <button bindtap="joinPay" wx:else>加入并支付￥{{tools.plusFuDongJia(detailData.price,0)}}元</button>
            </view>
        </view>
        <cialog show="{{showPay}}">
            <view class="pay_dialog">
                <view class="v_money">
                    <text>需支付{{tools.plusFuDongJia(detailData.price,0)}}元</text>
                </view>
                <view>
                    <view bindtap="select" class="l_item {{isCanPay?'hui2':'hui3'}}" data-ep="0">
                        <image src="" style="width:20rpx;height:20rpx"></image>
                        <text>余额支付</text>
                        <text style="flex:1;margin-left:26rpx">剩余：{{balance}}</text>
                        <view style="width:50rpx">
                            <icon size="20" style="margin-right:12rpx;" type="success" wx:if="{{position==0}}"></icon>
                        </view>
                    </view>
                </view>
                <view>
                    <view bindtap="select" class="l_item hui1" data-ep="1">
                        <image src="" style="width:20rpx;height:20rpx"></image>
                        <text>微信支付</text>
                        <text style="flex:1;margin-left:26rpx"></text>
                        <view style="width:50rpx">
                            <icon size="20" style="margin-right:12rpx;" type="success" wx:if="{{position==1}}"></icon>
                        </view>
                    </view>
                </view>
                <button bindtap="pay" class="zhif">支付</button>
            </view>
        </cialog>
    </view>
</view>
<authdialog autoShow="{{showModal}}" bindauthEvent="bindauthEvent" force="{{true}}" isPhone="{{true}}"></authdialog>
<wxs module="tools" src="../tools.wxs" />