/* pages/purchaseRecord/index.wxss */
.scroll-views {
  height: 100%;
  width: 100%;
}

.record-list {
  padding: 18rpx 24rpx;
  background-color: var(--z_bg10);
  margin: 18rpx 24rpx 0;
  border-radius: 15rpx;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 24rpx;
  color: var(--z_zt20);
}

.time {
  font-size: 20rpx;
  margin-top: 20rpx;
  color: var(--z_zt10);
}