/* pages/purchaseRecord/index.wxss */
.scroll-views {
  height: 100%;
  width: 100%;
  padding-bottom: 250rpx;
}

.goods-list {
  padding: 18rpx 24rpx;
  background-color: var(--z_bg10);
  margin: 18rpx 24rpx 0;
  border-radius: 15rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.content {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
  width: 100%;
}

.name {
  font-size: 24rpx;
  color: var(--z_zt20);
}

.stock {
  font-size: 20rpx;
  margin-top: 15rpx;
  color: var(--z_zt10);
}

.price {
  font-size: 20rpx;
  margin-top: 20rpx;
  color: var(--z_zt30);
}

.cover {
  height: 100rpx;
  width: 130rpx;
  border-radius: 10rpx;
}

.but-operate {
  width: 100%;
  display: flex;
  margin-top: 15rpx;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.buy-btn {
  width: 28rpx;
  height: 28rpx;
}

.buy-count {
  padding: 2rpx 20rpx;
  font-size: 20rpx;
  margin-left: 8rpx;
  margin-right: 8rpx;
  background-color: var(--z_bgbg);
}

.shopping-card {
  height: 130rpx;
  position: fixed;
  z-index: 999;
  left: 0;
  right: 0;
  background-color: var(--z_bg30);
  bottom: 0;
  display: flex;
  align-items: center;
  width: 100%;
  border-top-left-radius: 10rpx;
  border-top-right-radius: 10rpx;
}

.shopping-card .shopping-img {
  height: 88rpx;
  width: 88rpx;
  margin-left: 30rpx;
}
.shopping-counts{
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 20rpx;
}
.shopping-pay{
  background-color: var(--z_zt30);
  font-size: 26rpx;
  width: 150rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  margin-right: 30rpx;
}
.totalPrice{
  font-size: 30rpx;
  color: var(--z_zt30);
  
}
.totalCount{
  font-size: 20rpx;
  margin-top: 20rpx;
  color: var(--z_zt10);
  padding-left: 6rpx;
}
.pay_dialog {
  background: #eee;
  width: 600rpx;
  border-radius: 16rpx;
}
.v_money {
  width: 100%;
  height: 150rpx;
  justify-content: center;
}

.l_item,
.v_money {
    display: flex;
    align-items: center;
}

.l_item {
    height: 100rpx;
    background-color: #fff;
    border-radius: 16rpx;
    padding: 0 12rpx;
    margin: 16rpx 6% 0;
}

.hui1 {
    color: #333;
}

.hui2 {
    color: #666;
}

.hui3 {
    color: #999;
}

.zhif {
    background-color: #ffb51a;
    color: #fff;
    margin: 80rpx 100rpx;
}
